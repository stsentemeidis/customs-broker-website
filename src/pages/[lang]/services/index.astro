---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import ServiceCard from '../../../components/ServiceCard.astro';
import CtaBand from '../../../components/CtaBand.astro';
import Icon from '../../../components/Icon.astro';
import { t, langPaths, type Lang } from '../../../i18n';
import { serviceSlugs } from '../../../data/site';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const d = t(lang);
---
<Base lang={lang} title={d.nav.services} description={d.services.lead}>
  <PageHero lang={lang} eyebrow={d.services.eyebrow} title={d.services.title} lead={d.services.lead} crumbs={[{ label: d.nav.services }]} />
  <section class="section">
    <div class="container">
      <div class="grid grid--3">
        {serviceSlugs.map((slug) => <ServiceCard lang={lang} slug={slug} />)}
      </div>
      <div class="callout" data-reveal>
        <Icon name="info" size={22} />
        <div>
          <h3>{d.services.requirementTitle}</h3>
          <p set:html={d.services.requirementText} />
        </div>
      </div>
    </div>
  </section>
  <CtaBand lang={lang} />
</Base>
